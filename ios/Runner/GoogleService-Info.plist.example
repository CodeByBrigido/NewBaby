	<string>SUA_API_KEY_IOS</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>BUNDLE_ID</key>
	<string>br.com.brigido.meuBebe</string>
	<key>PROJECT_ID</key>
	<string>seu-projeto-firebase</string>
	<key>STORAGE_BUCKET</key>
