rules_version = '2';

// Meu Bebê - cada conta só enxerga os próprios dados.
//
// Todo o conteúdo do aplicativo vive sob users/{uid}. Qualquer leitura ou
// escrita fora do próprio uid é negada.
//
// Os arquivos em si não passam por aqui - eles ficam no Google Drive, sob a
// permissão OAuth `drive.file`. O Firestore guarda apenas metadados.
//
// Além do isolamento entre contas, estas regras limitam o **formato** do que
// pode ser gravado. Não é excesso de zelo: o aplicativo é público, então
// qualquer pessoa instala, entra e passa a poder escrever no próprio espaço -
// e quem paga essa conta é quem publicou. Um documento fora do formato
// esperado só pode ter vindo de algo que não é este aplicativo.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Campo de texto ausente, nulo, ou dentro do limite de caracteres.
    function textUpTo(field, max) {
      let data = request.resource.data;
      return !(field in data)
          || data[field] == null
          || (data[field] is string && data[field].size() <= max);
    }

    function isValidProfile() {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'nome', 'nascimento', 'genero', 'pesoGramas',
               'alturaCm', 'hospital', 'fotoDriveId', 'pastaRaizId',
               'arquivoInfoId',
               // A licença do plano Premium, desta conta.
               //
               // Precisa estar nesta lista mesmo que o aplicativo nunca
               // escreva o campo. Num `set` com `merge`, o
               // `request.resource.data` é o documento **resultante**, e não
               // só o que veio na escrita: assim que o campo existir no
               // documento, ele aparece aqui em toda gravação de perfil. Sem
               // esta linha, virar a licença no console passaria a recusar
               // qualquer edição de cadastro daquela conta, e o erro
               // apareceria longe da causa.
               'premium',
               // A língua em que as pastas do Drive foram criadas. Gravada
               // uma vez, no cadastro, e nunca mais: é o que permite achar a
               // cápsula de quem criou em inglês e lê em português.
               'idiomaDasPastas'
             ])
          && (!('premium' in data) || data.premium == null
              || data.premium is bool)
          && textUpTo('nome', 120)
          && textUpTo('hospital', 200)
          && textUpTo('genero', 20)
          && textUpTo('fotoDriveId', 200)
          && textUpTo('pastaRaizId', 200)
          && textUpTo('arquivoInfoId', 200)
          && textUpTo('idiomaDasPastas', 10);
    }

    function isValidEntry() {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'tipo', 'data', 'criadoEm', 'idadeDias', 'balde', 'baldeNome',
               'titulo', 'descricao', 'arquivos', 'crescimento', 'status',
               'uploadStatus', 'excluidoEm', 'erro', 'lacradoAte',
               // Id do `.txt` da carta no Drive. Fica fora de `arquivos`
               // porque não é anexo: é a mesma carta em outro formato.
               'arquivoTextoId',
               // Posição escolhida à mão na lista de documentos.
               'ordem',
               // Legado: versões antigas gravavam aqui uma segunda cópia do
               // texto das cartas. O aplicativo não escreve mais este campo,
               // mas quem tem documentos antigos precisa poder editá-los.
               'busca'
             ])
          && textUpTo('titulo', 200)
          // Uma carta pode ser longa. 20 mil caracteres é folgado e ainda
          // muito abaixo do limite de 1 MiB por documento do Firestore.
          && textUpTo('descricao', 20000)
          && textUpTo('erro', 500)
          && textUpTo('arquivoTextoId', 200)
          && textUpTo('tipo', 30)
          && textUpTo('status', 20)
          && textUpTo('uploadStatus', 20)
          && (!('ordem' in data) || data.ordem == null || data.ordem is int)
          && (!('arquivos' in data)
              || data.arquivos == null
              || (data.arquivos is list && data.arquivos.size() <= 60));
    }

    // O progresso do catálogo de sugestões: se foi feita, se foi dispensada,
    // e quais itens do checklist estão marcados. Nada aqui é texto livre da
    // pessoa - os itens vêm do catálogo, que mora no aplicativo - então o
    // limite existe só para impedir que alguém use o documento como depósito.
    function isValidSuggestion() {
      let data = request.resource.data;
      return data.keys().hasOnly(['feita', 'dispensada', 'marcados'])
          && (!('feita' in data) || data.feita is bool)
          && (!('dispensada' in data) || data.dispensada is bool)
          && (!('marcados' in data)
              || data.marcados == null
              || (data.marcados is list && data.marcados.size() <= 40));
    }

    function isValidFolder() {
      return request.resource.data.keys().hasOnly([
               'caminho', 'driveId', 'criadoEm'
             ])
          && textUpTo('caminho', 200)
          && textUpTo('driveId', 200);
    }

    match /users/{uid} {
      // O aplicativo nunca grava neste documento: ele existe só como pai das
      // subcoleções. Apagar precisa ser possível, para "apagar minha conta".
      allow read, delete: if isOwner(uid);
      allow create, update: if false;

      match /perfil/{documento} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidProfile();
      }

      match /entradas/{entrada} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidEntry();
      }

      // Restos do compartilhamento familiar, que saiu antes da publicação.
      //
      // Nada escreve mais aqui, mas quem instalou a versão de teste tem
      // documentos gravados. Sem estas duas linhas, "apagar minha conta e
      // meus dados" passaria a deixar rastro em silêncio, e essa é uma
      // promessa feita à Play Store. O dia em que a última conta antiga for
      // apagada, estes blocos podem sair.
      match /miniaturas/{driveId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      match /imagens/{driveId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      match /sugestoes/{sugestao} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidSuggestion();
      }

      match /pastas/{chave} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidFolder();
      }

      // Qualquer subcoleção que este aplicativo não conhece: negada.
      //
      // Antes havia aqui um `match /{document=**}` liberando tudo. Como no
      // Firestore basta uma regra permitir para o acesso passar, aquele
      // curinga anularia toda a validação escrita acima - é o tipo de erro
      // que não aparece em teste nenhum, porque tudo continua funcionando.
      match /{outra}/{documento=**} {
        allow read, write: if false;
      }
    }

    // Nada mais é acessível.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
