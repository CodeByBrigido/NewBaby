rules_version = '2';

// Meu Bebê - cada conta só enxerga os próprios dados.
//
// Todo o conteúdo do aplicativo vive sob users/{uid}. Qualquer leitura ou
// escrita fora do próprio uid é negada.
//
// Os arquivos em si não passam por aqui - eles ficam no Google Drive, sob a
// permissão OAuth `drive.file`. O Firestore guarda apenas metadados.
//
// Além do isolamento entre contas, estas regras limitam o **formato** do que
// pode ser gravado. Não é excesso de zelo: o aplicativo é público, então
// qualquer pessoa instala, entra e passa a poder escrever no próprio espaço -
// e quem paga essa conta é quem publicou. Um documento fora do formato
// esperado só pode ter vindo de algo que não é este aplicativo.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ------------------------------------------------- acesso de familiar
    //
    // O Drive controla quem pode ler os arquivos; o Firestore controla quem
    // pertence a qual cápsula. São permissões separadas de propósito, e o
    // código de convite é só a segunda: ele não abre o Drive de ninguém.

    function familyLink() {
      return get(/databases/$(database)/documents/familyAccess/$(request.auth.uid)).data;
    }

    /// Se quem está pedindo tem vínculo de leitura com a cápsula de [uid].
    function isFamilyOf(uid) {
      return request.auth != null
          && exists(/databases/$(database)/documents/familyAccess/$(request.auth.uid))
          && familyLink().ownerUid == uid
          && familyLink().role == 'viewer';
    }

    /// Os tipos que o familiar enxerga.
    ///
    /// Cartas ficam de fora: são o que há de mais íntimo na cápsula, e quem
    /// escreve para a filha ler aos dezoito anos não escreve para a família
    /// inteira. Desenhos e áudios também, por não constarem da lista de
    /// permissões combinada - o padrão seguro é não mostrar o que ninguém
    /// pediu para mostrar.
    function tipoVisivelParaFamilia(tipo) {
      return tipo in ['nascimento', 'foto', 'video', 'documento', 'crescimento'];
    }

    /// Uma entrada lacrada não é visível para a família antes da data. O
    /// lacre é uma promessa, e promessa vale no servidor.
    ///
    /// A exigência é dura de propósito: o campo tem que estar lá e tem que
    /// ser nulo. A versão tolerante, que também aceitava o campo ausente,
    /// **vazava numa consulta de lista** - e isso foi medido, não suposto.
    /// Numa consulta, o Firestore avalia a regra contra a própria consulta,
    /// não contra cada documento devolvido: `!('lacradoAte' in resource.data)`
    /// dá verdadeiro quando o dado ainda nem foi lido, e a entrada lacrada
    /// saía junto com as outras. Escrita assim, a única forma de a consulta
    /// passar é o aplicativo pedir explicitamente as não lacradas.
    ///
    /// O preço: uma entrada gravada sem o campo fica invisível para a
    /// família. É o erro certo para se cometer, e por isso o aplicativo
    /// sempre grava `lacradoAte`, nulo inclusive.
    function naoLacrada() {
      return resource.data.lacradoAte == null;
    }

    /// O que está na lixeira não é da conta de mais ninguém.
    ///
    /// Pela mesma razão da função acima, a comparação é direta: assim a
    /// consulta do familiar é obrigada a pedir só o que está ativo.
    function naoExcluida() {
      return resource.data.status == 'ativo';
    }

    // Campo de texto ausente, nulo, ou dentro do limite de caracteres.
    function textUpTo(field, max) {
      let data = request.resource.data;
      return !(field in data)
          || data[field] == null
          || (data[field] is string && data[field].size() <= max);
    }

    function isValidProfile() {
      return request.resource.data.keys().hasOnly([
               'nome', 'nascimento', 'genero', 'pesoGramas',
               'alturaCm', 'hospital', 'fotoDriveId', 'pastaRaizId'
             ])
          && textUpTo('nome', 120)
          && textUpTo('hospital', 200)
          && textUpTo('genero', 20)
          && textUpTo('fotoDriveId', 200)
          && textUpTo('pastaRaizId', 200);
    }

    function isValidEntry() {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'tipo', 'data', 'criadoEm', 'idadeDias', 'balde', 'baldeNome',
               'titulo', 'descricao', 'arquivos', 'crescimento', 'status',
               'uploadStatus', 'excluidoEm', 'erro', 'lacradoAte',
               // Legado: versões antigas gravavam aqui uma segunda cópia do
               // texto das cartas. O aplicativo não escreve mais este campo,
               // mas quem tem documentos antigos precisa poder editá-los.
               'busca'
             ])
          && textUpTo('titulo', 200)
          // Uma carta pode ser longa. 20 mil caracteres é folgado e ainda
          // muito abaixo do limite de 1 MiB por documento do Firestore.
          && textUpTo('descricao', 20000)
          && textUpTo('erro', 500)
          && textUpTo('tipo', 30)
          && textUpTo('status', 20)
          && textUpTo('uploadStatus', 20)
          && (!('arquivos' in data)
              || data.arquivos == null
              || (data.arquivos is list && data.arquivos.size() <= 60));
    }

    // O progresso do catálogo de sugestões: se foi feita, se foi dispensada,
    // e quais itens do checklist estão marcados. Nada aqui é texto livre da
    // pessoa - os itens vêm do catálogo, que mora no aplicativo - então o
    // limite existe só para impedir que alguém use o documento como depósito.
    function isValidSuggestion() {
      let data = request.resource.data;
      return data.keys().hasOnly(['feita', 'dispensada', 'marcados'])
          && (!('feita' in data) || data.feita is bool)
          && (!('dispensada' in data) || data.dispensada is bool)
          && (!('marcados' in data)
              || data.marcados == null
              || (data.marcados is list && data.marcados.size() <= 40));
    }

    /// Se a entrada dona desta miniatura é das que a família enxerga.
    ///
    /// A conferência é feita na entrada, e não em campos copiados para a
    /// miniatura, de propósito: campo copiado é campo que sai de sincronia,
    /// e o dia em que sair, o lacre vaza por uma imagem de 200 pixels. Um
    /// `get()` custa uma leitura e sempre diz a verdade.
    function entradaVisivelParaFamilia(uid, entradaId) {
      let entrada = get(
        /databases/$(database)/documents/users/$(uid)/entradas/$(entradaId)
      ).data;
      return tipoVisivelParaFamilia(entrada.tipo)
          && entrada.lacradoAte == null
          && entrada.status == 'ativo';
    }

    /// Uma miniatura: poucos quilobytes, e nada além disso.
    ///
    /// O limite é a diferença entre uma miniatura e um lugar para esconder
    /// arquivo. Um documento do Firestore aceita 1 MiB; 200 KB é folgado
    /// para uma imagem de 320 pixels e ainda deixa claro o que isto é.
    function isValidThumbnail() {
      let data = request.resource.data;
      return data.keys().hasOnly(['entradaId', 'bytes', 'criadoEm'])
          && data.entradaId is string
          && data.entradaId.size() <= 200
          && data.bytes is bytes
          && data.bytes.size() <= 200 * 1024;
    }

    function isValidFolder() {
      return request.resource.data.keys().hasOnly([
               'caminho', 'driveId', 'criadoEm'
             ])
          && textUpTo('caminho', 200)
          && textUpTo('driveId', 200);
    }

    match /users/{uid} {
      // O aplicativo nunca grava neste documento: ele existe só como pai das
      // subcoleções. Apagar precisa ser possível, para "apagar minha conta".
      allow read, delete: if isOwner(uid);
      allow create, update: if false;

      match /perfil/{documento} {
        // O familiar precisa do nome e da data de nascimento para a linha do
        // tempo fazer sentido. É o único documento do perfil que ele lê.
        allow read: if isOwner(uid) || isFamilyOf(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidProfile();
      }

      match /entradas/{entrada} {
        // A regra vale por documento, inclusive em consulta de lista: uma
        // busca que traga uma carta falha inteira. Isso é proposital - o
        // filtro por tipo no aplicativo é conveniência, esta linha é a
        // garantia.
        allow read: if isOwner(uid)
                    || (isFamilyOf(uid)
                        && tipoVisivelParaFamilia(resource.data.tipo)
                        && naoLacrada()
                        && naoExcluida());
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidEntry();
      }

      // A miniatura de cada arquivo, indexada pelo id dele no Drive.
      //
      // Existe porque o escopo `drive.file` só alcança arquivos que **este**
      // aplicativo criou ou que a pessoa apontou pelo seletor. Compartilhar
      // a pasta dá acesso no Drive, mas não põe os arquivos no conjunto
      // autorizado do aplicativo de quem foi convidado: `files.get` responde
      // 404. Com a miniatura aqui, o aplicativo dela monta a linha do tempo
      // inteira sem fazer **nenhuma** chamada ao Drive.
      //
      // `list` é negado: a família alcança uma miniatura de cada vez, pelo
      // id que já veio na entrada. Assim a conferência abaixo, que depende
      // do documento, nunca cai no caso em que a regra é avaliada contra a
      // consulta em vez do documento.
      match /miniaturas/{driveId} {
        allow get: if isOwner(uid)
                   || (isFamilyOf(uid)
                       && entradaVisivelParaFamilia(uid, resource.data.entradaId));
        allow list: if false;
        allow create, update: if isOwner(uid) && isValidThumbnail();
        allow delete: if isOwner(uid);
      }

      match /sugestoes/{sugestao} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidSuggestion();
      }

      match /pastas/{chave} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidFolder();
      }

      // Qualquer subcoleção que este aplicativo não conhece: negada.
      //
      // Antes havia aqui um `match /{document=**}` liberando tudo. Como no
      // Firestore basta uma regra permitir para o acesso passar, aquele
      // curinga anularia toda a validação escrita acima - é o tipo de erro
      // que não aparece em teste nenhum, porque tudo continua funcionando.
      match /{outra}/{documento=**} {
        allow read, write: if false;
      }
    }

    // ---------------------------------------------------- convites (códigos)
    //
    // O id do documento **é** o código. Ninguém lista esta coleção: só
    // alcança um documento quem já sabe o código. E saber o código não basta,
    // porque a leitura ainda exige ser o dono ou ser o email convidado.
    match /shareCodes/{codigo} {
      function convite() { return resource.data; }

      allow get: if request.auth != null
                 && (convite().ownerUid == request.auth.uid
                     || convite().email == request.auth.token.email);

      // Listar revelaria convites alheios, com email e id de pasta dentro.
      allow list: if false;

      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'ownerUid', 'folderId', 'email', 'nome',
                         'criadoEm', 'expiraEm', 'status'
                       ])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.folderId is string
                    && request.resource.data.folderId.size() <= 200
                    && textUpTo('nome', 120)
                    && request.resource.data.expiraEm is timestamp;

      // Quem foi convidado marca como usado; o dono revoga. Nada além disso.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status'])
                    && (
                      (convite().email == request.auth.token.email
                       && convite().status == 'pending'
                       && request.resource.data.status == 'used')
                      ||
                      (convite().ownerUid == request.auth.uid
                       && request.resource.data.status == 'revoked')
                    );

      allow delete: if request.auth != null
                    && convite().ownerUid == request.auth.uid;
    }

    // ------------------------------------------------------------- vínculos
    //
    // Um documento por familiar, com o uid dele como id. É o que faz o
    // aplicativo saber, na abertura seguinte, qual cápsula abrir.
    match /familyAccess/{uid} {
      allow read: if isOwner(uid)
                  || (request.auth != null
                      && resource.data.ownerUid == request.auth.uid);

      // Criar o próprio vínculo, e só com um convite que de fato exista,
      // esteja pendente, não tenha expirado e seja para este email. Esta é a
      // linha que transforma o código num acesso: sem ela, qualquer pessoa
      // logada escreveria o próprio vínculo para a cápsula que quisesse.
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly([
                         'ownerUid', 'folderId', 'role', 'email',
                         'codigo', 'criadoEm'
                       ])
                    && request.resource.data.role == 'viewer'
                    && request.resource.data.email == request.auth.token.email
                    && exists(/databases/$(database)/documents/shareCodes/$(request.resource.data.codigo))
                    && convitePara(request.resource.data);

      // Imutável: para mudar de cápsula, apaga e resgata outro código.
      allow update: if false;

      // A pessoa sai quando quiser; o dono revoga quando quiser.
      allow delete: if isOwner(uid)
                    || (request.auth != null
                        && resource.data.ownerUid == request.auth.uid);
    }

    /// O convite citado no vínculo confere com o que está sendo gravado.
    function convitePara(vinculo) {
      let c = get(/databases/$(database)/documents/shareCodes/$(vinculo.codigo)).data;
      return c.status == 'pending'
          && c.expiraEm > request.time
          && c.email == request.auth.token.email
          && c.ownerUid == vinculo.ownerUid
          && c.folderId == vinculo.folderId;
    }

    // Nada mais é acessível.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
