<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 e anteriores, onde vale o `fullBackupContent`.

  Mesmo efeito do data_extraction_rules.xml: nada do diretório privado do
  aplicativo entra no backup. Com `android:allowBackup="false"` isso já não
  seria alcançado, mas o arquivo existe para o dia em que alguém religar o
  backup sem lembrar do que ficava guardado ali.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
